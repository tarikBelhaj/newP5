{
  "_info": {
    "description": "Wan2.2-Animate Replace Mode — ComfyUI API Format",
    "source": "Adapted from kijai/ComfyUI-WanVideoWrapper wanvideo_WanAnimate_preprocess_example_02.json",
    "nodes_required": [
      "ComfyUI-WanVideoWrapper (kijai)",
      "ComfyUI-WanAnimatePreprocess (kijai)",
      "ComfyUI-VideoHelperSuite (Kosinkadink)",
      "ComfyUI-segment-anything-2"
    ],
    "models_required": "See worker/MODELS.md",
    "patch_targets": {
      "video_path": "node 1 inputs.video",
      "image_path": "node 2 inputs.image",
      "diffusion_model": "node 10 inputs.model_name",
      "vae_model": "node 11 inputs.vae_name",
      "text_encoder": "node 12 inputs.model_name",
      "clip_vision": "node 13 inputs.clip_name",
      "yolo_model": "node 20 inputs.model",
      "vitpose_model": "node 21 inputs.model",
      "num_frames": "node 1 outputs (auto-detected from video)",
      "width": "node 30 inputs.width",
      "height": "node 30 inputs.height",
      "steps": "node 27 inputs.steps",
      "positive_prompt": "node 14 inputs.positive_prompt"
    }
  },

  "1": {
    "class_type": "VHS_LoadVideo",
    "_meta": { "title": "Load Driving Video (user_video)" },
    "inputs": {
      "video": "PATCH:user_video_path",
      "force_rate": 0,
      "force_size": "Disabled",
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "choose video to upload": "video"
    }
  },

  "2": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Character Image (reference)" },
    "inputs": {
      "image": "PATCH:character_image_path",
      "upload": "image"
    }
  },

  "10": {
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Load Wan2.2-Animate Model" },
    "inputs": {
      "model_name": "PATCH:diffusion_model_name",
      "base_precision": "fp8_e4m3fn",
      "quantization": "fp8_e4m3fn",
      "load_device": "main_device",
      "attention_mode": "sdpa",
      "compile_args": null,
      "block_swap_args": null
    }
  },

  "11": {
    "class_type": "WanVideoVAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": {
      "model_name": "PATCH:vae_model_name",
      "precision": "bf16"
    }
  },

  "12": {
    "class_type": "WanVideoTextEncodeCached",
    "_meta": { "title": "Text Encoder (UMT5)" },
    "inputs": {
      "model_name": "PATCH:text_encoder_name",
      "positive_prompt": "PATCH:positive_prompt",
      "negative_prompt": "low quality, blurry, deformed, watermark, text",
      "quantization": "disabled",
      "force_offload": true,
      "use_disk_cache": false,
      "device": "gpu"
    }
  },

  "13": {
    "class_type": "CLIPVisionLoader",
    "_meta": { "title": "Load CLIP Vision" },
    "inputs": {
      "clip_name": "PATCH:clip_vision_name"
    }
  },

  "14": {
    "class_type": "WanVideoClipVisionEncode",
    "_meta": { "title": "CLIP Vision Encode (character identity)" },
    "inputs": {
      "clip_vision": ["13", 0],
      "image": ["2", 0],
      "strength": 1.0,
      "crop": "center"
    }
  },

  "20": {
    "class_type": "OnnxDetectionModelLoader",
    "_meta": { "title": "Load YOLO Detection Model" },
    "inputs": {
      "model": "PATCH:yolo_model_name"
    }
  },

  "21": {
    "class_type": "OnnxPoseModelLoader",
    "_meta": { "title": "Load ViTPose Model" },
    "inputs": {
      "model": "PATCH:vitpose_model_name"
    }
  },

  "22": {
    "class_type": "PoseAndFaceDetection",
    "_meta": { "title": "Pose + Face Detection (WanAnimatePreprocess)" },
    "inputs": {
      "images": ["1", 0],
      "detection_model": ["20", 0],
      "pose_model": ["21", 0],
      "retarget_image": ["2", 0],
      "width": "PATCH:width",
      "height": "PATCH:height",
      "detection_threshold": 0.3,
      "pose_threshold": 0.3
    }
  },

  "25": {
    "class_type": "SAM2ModelLoader",
    "_meta": { "title": "Load SAM2" },
    "inputs": {
      "model": "PATCH:sam2_model_name",
      "device": "cuda",
      "dtype": "float16"
    }
  },

  "26": {
    "class_type": "Sam2Segmentation",
    "_meta": { "title": "SAM2 Segmentation (person mask)" },
    "inputs": {
      "sam2_model": ["25", 0],
      "image": ["1", 0],
      "bboxes": ["22", 1],
      "threshold": 0.3,
      "individual_objects": false
    }
  },

  "27": {
    "class_type": "WanVideoAnimateEmbeds",
    "_meta": { "title": "Wan2.2-Animate Embeds (replace mode)" },
    "inputs": {
      "model": ["10", 0],
      "vae": ["11", 0],
      "clip_vision_output": ["14", 0],
      "images": ["1", 0],
      "ref_image": ["2", 0],
      "pose_images": ["22", 0],
      "face_images": ["22", 2],
      "background_images": ["1", 0],
      "mask": ["26", 0],
      "width": "PATCH:width",
      "height": "PATCH:height",
      "num_frames": "PATCH:num_frames",
      "mode": "replace",
      "pose_strength": 1.0,
      "face_strength": 1.0,
      "motion_strength": 1.0,
      "mask_strength": 1.0
    }
  },

  "28": {
    "class_type": "WanVideoSampler",
    "_meta": { "title": "Wan2.2 Sampler" },
    "inputs": {
      "model": ["10", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "image_embeds": ["27", 0],
      "steps": "PATCH:steps",
      "cfg": 1.0,
      "shift": 8.0,
      "scheduler": "unipc",
      "seed": -1,
      "force_offload": true,
      "batched_decode": false
    }
  },

  "29": {
    "class_type": "WanVideoDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "vae": ["11", 0],
      "samples": ["28", 0],
      "enable_vae_tiling": true,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 144
    }
  },

  "30": {
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Save Output Video" },
    "inputs": {
      "images": ["29", 0],
      "audio": ["1", 2],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "wan_animate_replace",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "pingpong": false,
      "save_output": true
    }
  }
}
