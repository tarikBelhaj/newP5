# ================================================================
# .env.local — Motion Avatar
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ================================================================

# ─── AI Provider ──────────────────────────────────────────────────────────────
# wan-vast      → Vast.ai Pod, ComfyUI self-hosted (GPU validation)
# wan-runpod    → RunPod Serverless, ComfyUI self-hosted (production)
# mock          → No GPU, simulated response (local dev, no API key needed)
AI_PROVIDER=wan-vast

# ─── Vast.ai Pod (AI_PROVIDER=wan-vast) ────────────────────────────────────
# Step 1: Get API key → https://cloud.vast.ai/console/cli/
# Step 2: Rent instance → fill INSTANCE_ID, SSH_HOST, SSH_PORT from console
VAST_API_KEY=
VAST_INSTANCE_ID=
VAST_SSH_HOST=
VAST_SSH_PORT=
VAST_SSH_USER=root
VAST_WORKDIR=/workspace/motion-avatar

# ─── GPU test settings (used by npm run vast:test-gpu) ─────────────────────
# fast = fewer steps, less VRAM, ~3 min on RTX 4090. Use for validation.
# standard = full quality, ~8 min.
TEST_QUALITY=fast

# Path to ComfyUI models on the Vast.ai instance (set after vast:setup)
# This is the remote path on the instance, not local.
MODEL_PATH=/comfyui/models

# ─── RunPod Serverless (AI_PROVIDER=wan-runpod, future production) ──────────
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# ─── Local dev ────────────────────────────────────────────────────────────────
# Set MOCK_AI=true to bypass all GPU calls during UI development.
MOCK_AI=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
